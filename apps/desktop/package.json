{
  "name": "@nautilus/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle-agent.mjs && vite build",
    "build:packages": "pnpm --workspace-root exec turbo run build --filter=@nautilus/desktop^... --filter=@nautilus/sync-agent^...",
    "dev": "node scripts/bundle-agent.mjs && vite",
    "dev:local": "node scripts/dev-desktop-entry.mjs && tauri dev",
    "tauri:dev": "node scripts/dev-desktop-entry.mjs && tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle-agent": "node scripts/bundle-agent.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-neutral": "0.6.3",
    "@fontsource/figtree": "5.3.0",
    "@nautilus/brand": "workspace:*",
    "@nautilus/copy": "workspace:*",
    "@nautilus/types": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-http": "2.6.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-shell": "2.3.6",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
