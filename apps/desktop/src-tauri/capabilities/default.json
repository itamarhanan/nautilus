{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Nautilus desktop app. It reads and writes only ~/.nautilus, reads folder listings and package.json files for project detection, talks HTTP to loopback and to the https Nautilus deployment the user configures, and can start exactly one program: its own sync agent. It also shows notifications, opens a project file in its default app for a conflict, closes its own window when quitting from the tray, and keeps each project's preview variables in the OS keychain. It reads env files only inside folders added as projects.",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:allow-destroy",
    "notification:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.nautilus/config.json"
        },
        {
          "path": "$HOME/.nautilus/state.json"
        },
        {
          "path": "$HOME/**/package.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.nautilus/config.json"
        },
        {
          "path": "$HOME/.nautilus/state.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/.nautilus"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/nautilus-sync-agent",
          "sidecar": true,
          "args": ["--launch-key-stdin"]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "allow-env-load",
    "allow-env-save",
    "allow-env-delete",
    "allow-env-scan"
  ]
}
