{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nautilus",
  "mainBinaryName": "nautilus-desktop",
  "version": "../package.json",
  "identifier": "dev.nautilus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nautilus",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nautilus",
    "copyright": "© 2026 Nautilus",
    "category": "DeveloperTool",
    "shortDescription": "Run coding agents from your phone.",
    "longDescription": "A private remote workspace for coding agents. Your projects stay on your PC, a cloud runner does the work, and your phone steers it.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nautilus-sync-agent"],
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["openssh-client"]
      },
      "rpm": {
        "depends": ["openssh-clients"]
      }
    }
  }
}
