{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,

  "ignoreBinaries": ["rustc", "bwrap"],
  "workspaces": {
    "apps/desktop": {
      "ignoreFiles": ["src-tauri/**"],
      "ignoreDependencies": ["postject"],
    },
    "apps/web": {
      "ignoreFiles": ["public/**"],
      // Listed so turbo builds the runner before the web app bundles it.
      "ignoreDependencies": ["@nautilus/runner"],
    },
    "apps/runner": {
      "ignoreDependencies": ["opencode-ai"],
    },
    "packages/brand": {
      "ignoreDependencies": ["@tauri-apps/cli"],
    },
  },
}
